#!/usr/bin/env bash
# claude-deepseek — thin wrapper that redirects Claude Code CLI to DeepSeek API.
# Source: https://api-docs.deepseek.com/zh-cn/quick_start/agent_integrations/claude_code
set -euo pipefail

ENV_FILE="$HOME/.config/claude-code/deepseek.env"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "Missing $ENV_FILE"
  echo "Create it with:"
  echo '  export DEEPSEEK_API_KEY="sk-..."'
  exit 1
fi

source "$ENV_FILE"

if [[ -z "${DEEPSEEK_API_KEY:-}" ]]; then
  echo "DEEPSEEK_API_KEY is empty in $ENV_FILE"
  exit 1
fi

export ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
export ANTHROPIC_AUTH_TOKEN="$DEEPSEEK_API_KEY"
export ANTHROPIC_MODEL="deepseek-v4-pro[1m]"
export ANTHROPIC_DEFAULT_OPUS_MODEL="deepseek-v4-pro[1m]"
export ANTHROPIC_DEFAULT_SONNET_MODEL="deepseek-v4-pro[1m]"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="deepseek-v4-flash"
export CLAUDE_CODE_SUBAGENT_MODEL="deepseek-v4-flash"
export CLAUDE_CODE_EFFORT_LEVEL="max"

# Interactive sessions (no --print) force --bare to prevent loading CLAUDE.md/routing rules.
# Without this, DeepSeek would see delegation rules and try to delegate to itself.
for arg in "$@"; do
  [[ "$arg" == "--print" ]] && exec claude "$@"
done
echo "[claude-deepseek] interactive session — --bare applied (project rules not loaded)" >&2
exec claude --bare "$@"
